# syntax=docker/dockerfile:1.4
# Builds the raft-node SUT binary with Antithesis instrumentation.
#
# Layer order is tuned for caching:
#   1. Base + apt packages — cached unless Dockerfile changes.
#   2. Toolexec wrapper install — cached unless ANTITHESIS_SDK_VERSION changes.
#   3. go.mod + go.sum + `go mod download` — cached unless deps change.
#   4. Full source COPY — invalidated on ANY source change.
#   5. Instrumented build — re-runs whenever source changes, but the Go
#      build cache mount makes incremental compilation fast.
#
# Stages:
#  1. builder — compiles the raft-node binary with `-toolexec=antithesis-go-toolexec`,
#     which adds coverage instrumentation and assertion catalogs inside
#     `go build` (no separate source-rewriting pass). Symbol tables land in
#     /symbols at link time.
#  2. runtime — minimal image with the built binary and the emitted symbols.

ARG ANTITHESIS_SDK_VERSION=v0.8.0

FROM docker.io/library/golang:1.27-bookworm AS builder

ARG ANTITHESIS_SDK_VERSION
ENV CGO_ENABLED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc libc6-dev git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install the Antithesis Go toolexec wrapper (pinned to the SDK version).
# Cache mounts preserve the module + build cache across builds; the resulting
# `antithesis-go-toolexec` binary lives in /go/bin which is part of the
# layer, so the install itself caches at the layer level too.
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go install github.com/antithesishq/antithesis-sdk-go/tools/antithesis-go-toolexec@${ANTITHESIS_SDK_VERSION}

WORKDIR /src

# Pre-pull dependencies. This layer only invalidates when go.mod or go.sum
# change — most edits to .go files leave it cached.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Full source (the patched library + antithesis/ harness).
COPY . .

# Build the raft-node binary with instrumentation. By default the wrapper
# instruments every package whose source is in the working tree (the raft
# library and antithesis/raft-node) and leaves downloaded dependencies alone.
# Symbol tables are kept in the build cache alongside their packages, so cache
# hits stay correct, and are copied to /symbols when the binary links.
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go build -toolexec=antithesis-go-toolexec -o /out/raft-node ./antithesis/raft-node

FROM docker.io/library/debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Antithesis requires symbols under /symbols/ for Go.
RUN mkdir -p /symbols /opt/antithesis/catalog
COPY --from=builder /symbols/ /symbols/

COPY --from=builder /out/raft-node /usr/local/bin/raft-node

ENV NO_COLOR=1

ENTRYPOINT ["/usr/local/bin/raft-node"]
